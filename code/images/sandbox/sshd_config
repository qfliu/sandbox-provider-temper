# Key-only SSH for the sandbox. Only the platform-internal key is trusted
# (D7); users' own keys are checked at the SSH gateway (D6).
Port 22
ListenAddress 0.0.0.0

# Only the per-sandbox ed25519 host key (D29), so clients can pin it.
HostKey /etc/ssh/ssh_host_ed25519_key

PermitRootLogin no
AllowUsers user
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /etc/sandbox/authorized_keys

# The key file is mounted from a Secret, whose perms/ownership don't satisfy
# StrictModes' checks on the user's home dir.
StrictModes no

# The platform multiplexes many exec/file sessions over one pooled
# connection per sandbox (default is 10).
MaxSessions 64

UsePAM no
PrintMotd no
X11Forwarding no
# Local forwarding to the sandbox's own loopback only: the API proxies HTTP
# to a port inside the sandbox over its SSH connection (D66). The SSH
# gateway refuses forwarding channels, so users can't use this; and no
# forward may leave the sandbox.
AllowTcpForwarding local
PermitOpen localhost:* 127.0.0.1:*
AllowStreamLocalForwarding no
AllowAgentForwarding no
PermitTunnel no

Subsystem sftp /usr/lib/openssh/sftp-server

# Errors only: the readiness probe opens a TCP connection every second and
# sshd would log each one ("Connection closed by …"), a line per second for
# the sandbox's whole life (Phase 5 batch review). Logins are logged by the
# gateway and the API (with the key); a sandbox's own log is under its
# user's control anyway (they're root inside).
LogLevel ERROR
